# ---- Ollama settings ----
OLLAMA_URL=http://localhost:11434
# Chat model — use llama3.2:3b on laptops with <=8 GB RAM
LLM_MODEL=llama3.2:3b
# Embedding model
EMBED_MODEL=nomic-embed-text

# ---- Vector store ----
# Path (relative to project root) where ChromaDB persists data
CHROMA_PATH=data/chroma

# ---- Retrieval ----
# Number of chunks to retrieve per question
TOP_K=5
# Minimum similarity score; below this we return "I couldn't find this"
SCORE_THRESHOLD=0.3

# ---- LLM ----
LLM_TEMPERATURE=0.1
# Context window (tokens); lower = less memory per request. 0 = model default.
LLM_NUM_CTX=4096
# Max tokens to generate per answer. 0 = unlimited.
LLM_NUM_PREDICT=512
# How long Ollama keeps the model in memory after a request (avoids slow
# reloads). Examples: "30m", "-1" (forever), "0" (unload immediately).
LLM_KEEP_ALIVE=30m

# ---- Tesseract OCR (only needed for scanned PDFs) ----
# Default is the standard Windows install path. Change for Mac/Linux:
#   TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
