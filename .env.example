# ---- Ollama settings ----
OLLAMA_URL=http://localhost:11434
# Chat model — use llama3.2:3b on laptops with <=8 GB RAM
LLM_MODEL=llama3.1:8b
# Embedding model
EMBED_MODEL=nomic-embed-text

# ---- Vector store ----
# Path (relative to project root) where ChromaDB persists data
CHROMA_PATH=data/chroma

# ---- Retrieval ----
# Number of chunks to retrieve per question
TOP_K=5
# Minimum similarity score; below this we return "I couldn't find this"
SCORE_THRESHOLD=0.3

# ---- LLM ----
LLM_TEMPERATURE=0.1
